---
// src/pages/en/perifericos/index.astro
import Layout from '../../../layouts/Layout.astro';
import SugerenciasSetup from '../../../components/SugerenciasSetup.astro';

const subcategorias = [
  {
    id: 'ratones',
    name: 'Mice',
    url: '/en/perifericos/ratones',
    badge: 'Ergonomics & Precision',
    image: 'https://m.media-amazon.com/images/I/618Xy2oRcUL.jpg',
    models: 'Logitech MX Master, Lift Vertical, CSL, Signature...',
    description: 'Ergonomic vertical anti-fatiga mice, quiet wireless productivity models, and high-precision optical sensors to protect your wrist.'
  },
  {
    id: 'teclados',
    name: 'Keyboards',
    url: '/en/perifericos/teclados',
    badge: 'Mechanical & Slim',
    image: 'https://m.media-amazon.com/images/I/71s7K0xjGRL.jpg',
    models: 'Logitech Wave Keys, K950, Mars Gaming, K120...',
    description: 'Ergonomic wave keyboards with memory foam wrist rests, ultra-thin low profile keyboards, and mechanical TKL models.'
  },
  {
    id: 'auriculares',
    name: 'Headphones',
    url: '/en/perifericos/auriculares',
    badge: 'ANC & Hi-Res Audio',
    image: 'https://m.media-amazon.com/images/I/61TWA8UQjQL.jpg',
    models: 'Soundcore Q30, JBL Quantum, Logitech, Sony...',
    description: 'Wireless headphones featuring hybrid Active Noise Cancellation (ANC), integrated microphones for video calls, and immersive sound.'
  },
  {
    id: 'monitores',
    name: 'Monitors',
    url: '/en/perifericos/monitores',
    badge: 'Ultrawide & 120Hz',
    image: 'https://m.media-amazon.com/images/I/51so8xGsVzL.jpg',
    models: 'Samsung ViewFinity 34", Philips, Asus Eye Care, Acer...',
    description: '21:9 WQHD ultrawide displays for massive multitasking, 120Hz IPS panels, and Eye Care visual health filters.'
  },
  {
    id: 'altavoces',
    name: 'Speakers',
    url: '/en/perifericos/altavoces',
    badge: 'Soundbars & 2.0 Audio',
    image: 'https://m.media-amazon.com/images/I/71fJagWPNlL.jpg',
    models: 'SOULION Soundbar, Logitech Z150, Amazon Basics...',
    description: 'Compact soundbars designed to fit directly under your monitor and 2.0 stereo speaker systems with Bluetooth 5.3.'
  }
];

const titulo = "High-Performance Peripherals & Hardware (2026)";
const descripcion = "Explore the best peripherals for your setup: ergonomic mice, low-profile keyboards, ANC headphones, ultrawide monitors, and desktop speakers.";
---

<Layout title={titulo} description={descripcion}>
  
  {/* Hero Header */}
  <section class="relative bg-slate-950 text-white rounded-3xl p-8 md:p-14 my-8 overflow-hidden border border-slate-800 shadow-2xl">
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
    
    <div class="relative z-10 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-bold uppercase tracking-wider mb-6">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        ZenZone Peripherals Ecosystem
      </div>
      
      <h1 class="text-4xl md:text-6xl font-black tracking-tight mb-6 leading-tight">
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-200 to-amber-500">High-Performance</span> & Ergonomic Peripherals
      </h1>
      
      <p class="text-base md:text-lg text-slate-300 leading-relaxed mb-4">
        The hardware components you interact with daily determine your postural health and work efficiency. Select a category below to access our specialized reviews.
      </p>
    </div>
  </section>

  {/* Category Cards */}
  <section class="mb-20">
    <div class="flex items-center justify-between gap-4 mb-8">
      <div>
        <h2 class="text-2xl font-bold text-slate-900">Hardware & Accessory Categories</h2>
        <p class="text-sm text-slate-500 mt-1">Explore our in-depth comparisons in panoramic format</p>
      </div>
      <div class="hidden sm:block h-px bg-slate-200 flex-grow"></div>
    </div>
    
    <div class="space-y-6">
      {subcategorias.map((subcat) => (
        <a 
          href={subcat.url}
          class="group bg-white border border-slate-200 rounded-3xl p-6 md:p-8 shadow-sm hover:shadow-xl hover:border-amber-400 transition-all duration-300 flex flex-col md:flex-row items-center justify-between gap-6 md:gap-8"
        >
          <div class="flex-1 space-y-3 w-full">
            <div class="flex flex-wrap items-center gap-3">
              <span class="bg-amber-400/10 text-amber-600 border border-amber-400/30 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
                {subcat.badge}
              </span>
              <span class="text-xs font-semibold text-slate-400 bg-slate-100 px-2.5 py-0.5 rounded-md">
                2026 Guide
              </span>
            </div>
            
            <h3 class="text-2xl md:text-3xl font-black text-slate-900 group-hover:text-amber-500 transition-colors">
              {subcat.name}
            </h3>
            
            <p class="text-sm text-slate-600 leading-relaxed max-w-2xl">
              {subcat.description}
            </p>

            <div class="pt-1 flex flex-wrap items-center gap-2 text-xs">
              <span class="font-bold text-slate-700">Featured models:</span>
              <span class="text-slate-500">{subcat.models}</span>
            </div>

            <div class="pt-3 inline-flex items-center text-sm font-bold text-amber-500 group-hover:translate-x-2 transition-transform">
              <span>Explore {subcat.name}</span>
              <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </div>

          <div class="w-full md:w-72 lg:w-80 h-44 bg-white rounded-2xl flex items-center justify-center p-2 relative overflow-hidden flex-shrink-0">
            <img 
              src={subcat.image} 
              alt={subcat.name} 
              class="max-h-40 w-auto object-contain transition-transform duration-500 group-hover:scale-105"
            />
          </div>
        </a>
      ))}
    </div>
  </section>

  <SugerenciasSetup 
    currentUrl="/en/perifericos"
    title="Keep Optimizing Your Workspace 🧘"
    subtitle="The best peripherals deliver twice the results when paired with quality ergonomic furniture:"
  />

</Layout>
