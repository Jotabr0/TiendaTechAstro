---
// src/pages/en/[category]/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const allReviews = await getCollection('reviews');
  const uniqueCategories = [...new Set(allReviews.map((review) => review.data.category))];

  return uniqueCategories.map((category) => {
    const filteredReviews = allReviews.filter((review) => review.data.category === category);
    return {
      params: { category },
      props: { reviews: filteredReviews },
    };
  });
}

const { category } = Astro.params;
const { reviews } = Astro.props;

const categoryNames: Record<string, string> = {
  'sillas-oficina': 'Office Chairs',
  'sillas-gaming': 'Gaming Chairs',
  'mesas-escritorio': 'Computer Desks',
  'perifericos': 'Peripherals',
  'soportes': 'Desk Mounts',
  'iluminacion': 'Lighting',
  'alfombrillas': 'Mouse Pads',
  'humidificadores': 'Humidifiers'
};

const displayTitle = categoryNames[category as string] || category;
---

<Layout 
  title={displayTitle} 
  description={`Discover the best reviews, comparisons, and deals on ${displayTitle} for your home setup.`}
>
  <div class="mb-10 pb-6 border-b border-slate-200">
    <h1 class="text-3xl md:text-4xl font-black text-slate-900 mb-4">
      {displayTitle}
    </h1>
    <p class="text-lg text-slate-600">
      Explore detailed reviews and find the perfect choices for your setup.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {reviews.map((review) => (
      <article class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col h-full group">
        
        <h2 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-amber-500 transition-colors">
          <a href={`/en/${category}/${review.id}`}>
            {review.data.title}
          </a>
        </h2>
        
        <p class="text-slate-600 text-sm mb-6 flex-grow line-clamp-3">
          {review.data.description}
        </p>
        
        <div class="mt-auto pt-4 border-t border-slate-100 flex justify-between items-center">
          <span class="text-xs font-semibold text-slate-400 bg-slate-100 px-2 py-1 rounded-md uppercase">
            Review
          </span>
          <a href={`/en/${category}/${review.id}`} class="text-amber-500 font-bold hover:text-amber-600 text-sm flex items-center gap-1">
            Read more <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

      </article>
    ))}
  </div>

  {reviews.length === 0 && (
    <div class="text-center py-12 bg-slate-50 rounded-2xl border border-dashed border-slate-300">
      <p class="text-slate-500">Content for this section is coming soon!</p>
    </div>
  )}
</Layout>
