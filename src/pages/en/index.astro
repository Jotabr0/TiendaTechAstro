const categories = [
  { 
    name: 'Ergonomic Office Chairs', 
    url: '/en/sillas-oficina', 
    badge: 'Lumbar Health', 
    image: 'https://m.media-amazon.com/images/I/61nb9ErcVpL.jpg',
