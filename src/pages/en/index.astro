    models: 'Quntis Screenbar, AURORIONCG, NEEWER, YICAIZI...',
    desc: 'Anti-glare monitor light bars, music-synced RGBIC LED strips, wall panel lights, and streaming key lights.' 
  },
  { 
    name: 'XXL Desk Mats & Pads', 
    url: '/en/alfombrillas', 
    badge: 'Desk Mats & RGB', 
    image: 'https://m.media-amazon.com/images/I/61aDkVI4OPL.jpg',
    models: 'Titanwolf Speed XXL, Logitech Desk Mat, Realky RGB...',
    desc: 'Giant 90x40 cm desk surfaces, RGB edge-lit mouse pads, 15W Qi wireless charging mats, and gel wrist rest pads.' 
  },
  { 
    name: 'Humidifiers & Aromatherapy', 
    url: '/en/humidificadores', 
    badge: 'Ultrasonic Air Care', 
