---
// 1. Importamos las funciones de la Content Layer API de Astro
import { getCollection, render } from 'astro:content';

// 2. Importamos el layout base que creamos antes
import Layout from '../../layouts/Layout.astro';

// 3. getStaticPaths es obligatorio en rutas dinámicas. 
// Define qué páginas se van a construir en tiempo de compilación.
export async function getStaticPaths() {
  // Buscamos todos los archivos .mdx dentro de src/content/reviews
  const allReviews = await getCollection('reviews');
  
  // Por cada archivo, le decimos a Astro qué URL debe crear y qué datos pasarle
  return allReviews.map(entry => ({
    params: { 
      category: entry.data.category, // Ej: "sillas-oficina" (viene del frontmatter del mdx)
      slug: entry.id                 // Ej: "mejor-silla" (es el nombre del archivo mdx)
    },
    props: { entry }, // Pasamos el artículo completo como propiedad a la vista
  }));
}

// 4. Recuperamos el artículo actual que Astro está procesando
const { entry } = Astro.props;

// 5. Renderizamos el contenido del MDX para pasarlo a HTML
const { Content } = await render(entry);
---

{/* 6. Envolvemos el contenido en nuestro Layout, pasándole el SEO */}
<Layout title={entry.data.title} description={entry.data.description}>
  
  {/* El contenedor 'prose' formateará automáticamente el Markdown */}
  <article class="prose prose-slate max-w-none mx-auto">
    <Content />
  </article>

</Layout>