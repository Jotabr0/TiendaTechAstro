---
// src/components/AmazonBox.astro
import { getLangFromUrl, useTranslations } from '../i18n/ui';

interface Props {
  title: string;
  price?: string;
  imageUrl: string;
  amazonUrl: string;
  badge?: string;
  rating?: string;
  features?: string[];
  description?: string;
}

const { title, price, imageUrl, amazonUrl, badge, rating = "4.6", features, description } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="not-prose my-8 bg-white border border-slate-200 rounded-3xl p-6 md:p-8 shadow-sm hover:shadow-xl hover:border-amber-400/80 transition-all duration-300 relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-6 md:gap-8">
  
  {/* Badge flotante opcional */}
  {badge && (
    <div class="absolute top-0 right-0 z-10 bg-gradient-to-l from-amber-500 to-amber-600 text-white text-[11px] font-extrabold uppercase px-4 py-1.2 rounded-bl-2xl shadow-sm tracking-wider">
      {badge}
    </div>
  )}

  {/* Contenedor de la Imagen con Marco Limpio */}
  <div class="w-full md:w-56 h-52 bg-white rounded-2xl p-4 flex items-center justify-center relative flex-shrink-0">
    <img 
      src={imageUrl} 
      alt={`${t('amazon.imagenDe')} ${title}`} 
      width="200"
      height="200"
      decoding="async"
      class="max-h-44 w-auto object-contain transition-transform duration-500 hover:scale-105"
      loading="lazy"
    />
  </div>

  {/* Información y detalles del producto */}
  <div class="flex-1 w-full flex flex-col justify-between space-y-4 text-left">
    
    <div class="space-y-2">
      {/* Estrellas y Verificado Amazon */}
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="inline-flex items-center text-amber-500 font-bold gap-1 bg-amber-50 px-2.5 py-1 rounded-lg border border-amber-200/60">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          {rating} {t('amazon.estrellas')}
        </span>
        <span class="text-slate-400 font-medium">•</span>
        <span class="text-slate-500 font-semibold">{t('amazon.verificado')}</span>
      </div>

      {/* Título Principal */}
      <h3 class="text-xl md:text-2xl font-black text-slate-900 leading-tight">
        {title}
      </h3>

      {/* Descripción opcional */}
      {description && (
        <p class="text-sm text-slate-600 leading-relaxed">
          {description}
        </p>
      )}

      {/* Lista rápida de características si existen */}
      {features && features.length > 0 && (
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 pt-1 text-xs text-slate-700 font-medium">
          {features.map((feat) => (
            <li class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
              <span>{feat}</span>
            </li>
          ))}
        </ul>
      )}
    </div>

    {/* Precio y Botón de Acción */}
    <div class="pt-2 border-t border-slate-100 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
      {price ? (
        <div>
          <span class="text-xs text-slate-400 block font-semibold">{t('amazon.precioRecomendado')}</span>
          <span class="text-2xl font-black text-slate-900">{price}</span>
        </div>
      ) : (
        <div class="text-xs text-slate-500 font-medium flex items-center gap-1">
          <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>{t('amazon.stockActualizado')}</span>
        </div>
      )}

      <a 
        href={amazonUrl} 
        target="_blank" 
        rel="nofollow noopener sponsored"
        class="inline-flex items-center justify-center gap-2.5 bg-gradient-to-r from-amber-400 via-amber-500 to-amber-500 hover:from-amber-500 hover:to-amber-600 text-slate-950 font-black px-7 py-3.5 rounded-2xl shadow-md hover:shadow-lg transition-all duration-200 text-sm group"
      >
        <span>{t('amazon.verOferta')}</span>
        <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

  </div>
</div>