---
// src/components/Header.astro
import { getLangFromUrl, useTranslations, getRelativeLocaleUrl } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

// Calcular las URLs para alternar idioma
const pathWithoutLang = currentPath.replace(/^\/en(\/|$)/, '/');
const esUrl = pathWithoutLang === '' ? '/' : pathWithoutLang;
const enUrl = pathWithoutLang === '/' ? '/en/' : `/en${pathWithoutLang}`;

// Array centralizado de navegación traducido
const categories = [
  { name: t('nav.sillasOficina'), rawUrl: '/sillas-oficina', icon: '🪑' },
  { name: t('nav.sillasGaming'), rawUrl: '/sillas-gaming', icon: '🎮' },
  { name: t('nav.mesas'), rawUrl: '/mesas-escritorio', icon: '🖥️' },
  { 
    name: t('nav.perifericos'), 
    rawUrl: '/perifericos',
    icon: '⌨️',
    subcategories: [
      { name: t('nav.ratones'), rawUrl: '/perifericos/ratones', icon: '🖱️' },
      { name: t('nav.teclados'), rawUrl: '/perifericos/teclados', icon: '⌨️' },
      { name: t('nav.auriculares'), rawUrl: '/perifericos/auriculares', icon: '🎧' },
      { name: t('nav.monitores'), rawUrl: '/perifericos/monitores', icon: '🖥️' },
      { name: t('nav.altavoces'), rawUrl: '/perifericos/altavoces', icon: '🔊' },
    ]
  },
  { name: t('nav.iluminacion'), rawUrl: '/iluminacion', icon: '💡' },
  { name: t('nav.alfombrillas'), rawUrl: '/alfombrillas', icon: '🖱️' },
  { name: t('nav.humidificadores'), rawUrl: '/humidificadores', icon: '💨' },
];

const homeUrl = getRelativeLocaleUrl(lang, '/');
---

<header class="bg-slate-950/95 backdrop-blur-md border-b border-slate-800/80 sticky top-0 z-50 shadow-xl transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex justify-between items-center h-20 gap-4">
      
      {/* Logo ZenZone */}
      <a href={homeUrl} class="flex-shrink-0 flex items-center transition-transform hover:scale-105" aria-label="ZenZone - Home">
        <img 
          class="h-14 sm:h-16 w-auto object-contain" 
          src="/images/logozenzone-removebg-preview.png" 
          alt="ZenZone - Setup y Oficina Personal" 
        />
      </a>

      {/* Navegación Desktop */}
      <nav class="hidden lg:flex items-center space-x-1 xl:space-x-2">
        {categories.map((category) => {
          const categoryUrl = getRelativeLocaleUrl(lang, category.rawUrl);
          return category.subcategories ? (
            <div class="relative group py-6">
              <a 
                href={categoryUrl} 
                class="text-sm font-semibold text-slate-300 hover:text-amber-400 px-3 py-2 rounded-xl hover:bg-slate-900 transition-all inline-flex items-center gap-1.5"
              >
                <span>{category.name}</span>
                <svg class="w-4 h-4 text-slate-400 transition-transform duration-200 group-hover:rotate-180 group-hover:text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </a>
              
              {/* Dropdown Menu en Hover */}
              <div class="absolute left-0 top-full pt-1 hidden group-hover:block w-56 z-50">
                <div class="bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl p-2 space-y-1">
                  <a
                    href={categoryUrl}
                    class="block px-3 py-2 rounded-xl text-xs font-bold text-amber-400 hover:bg-slate-800 uppercase tracking-wider flex items-center justify-between"
                  >
                    <span>{t('nav.verTodoPerifericos')}</span>
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                  <div class="h-px bg-slate-800 my-1"></div>
                  {category.subcategories.map((sub) => (
                    <a 
                      href={getRelativeLocaleUrl(lang, sub.rawUrl)} 
                      class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-300 hover:text-amber-400 hover:bg-slate-800 transition-colors"
                    >
                      <span class="text-base">{sub.icon}</span>
                      <span>{sub.name}</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a 
              href={categoryUrl} 
              class="text-sm font-semibold text-slate-300 hover:text-amber-400 px-3 py-2 rounded-xl hover:bg-slate-900 transition-all"
            >
              {category.name}
            </a>
          );
        })}
      </nav>

      {/* Botones Derecha: Selector de Idioma ES | EN + Menú Móvil */}
      <div class="flex items-center gap-3">
        {/* Selector de Idioma (Desktop & Mobile) */}
        <div class="flex items-center bg-slate-900 border border-slate-800 rounded-full p-1 text-xs font-bold shadow-inner">
          <a
            href={esUrl}
            class={`px-2.5 py-1 rounded-full transition-all ${lang === 'es' ? 'bg-amber-400 text-slate-950 font-black shadow-sm' : 'text-slate-400 hover:text-white'}`}
            aria-label="Cambiar a Español"
          >
            ES
          </a>
          <a
            href={enUrl}
            class={`px-2.5 py-1 rounded-full transition-all ${lang === 'en' ? 'bg-amber-400 text-slate-950 font-black shadow-sm' : 'text-slate-400 hover:text-white'}`}
            aria-label="Switch to English"
          >
            EN
          </a>
        </div>

        {/* Botón Menú Móvil */}
        <div class="lg:hidden flex items-center">
          <button 
            id="mobile-menu-btn" 
            class="text-slate-300 hover:text-amber-400 p-2.5 rounded-xl bg-slate-900 border border-slate-800 focus:outline-none transition-colors" 
            aria-label="Toggle navegación móvil"
          >
            {/* Icono Hamburguesa */}
            <svg id="menu-icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
            {/* Icono Cerrar X */}
            <svg id="menu-icon-close" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
      </div>

    </div>
  </div>

  {/* Menú Móvil Desplegable */}
  <div id="mobile-menu" class="hidden lg:hidden bg-slate-900 border-t border-slate-800 max-h-[85vh] overflow-y-auto">
    <nav class="px-4 pt-3 pb-6 space-y-2">
      {categories.map((category) => {
        const categoryUrl = getRelativeLocaleUrl(lang, category.rawUrl);
        return category.subcategories ? (
          <div class="bg-slate-950/60 rounded-2xl border border-slate-800/80 p-2 space-y-1">
            <div class="flex items-center justify-between">
              <a 
                href={categoryUrl} 
                class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-base font-bold text-amber-400"
              >
                <span>{category.icon}</span>
                <span>{category.name}</span>
              </a>
              <button 
                id="toggle-subcat-btn"
                class="p-2 text-slate-400 hover:text-amber-400 focus:outline-none"
                aria-label="Abrir subcategorías"
              >
                <svg id="subcat-arrow" class="w-5 h-5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
            </div>
            
            {/* Subcategorías Móviles */}
            <div id="subcat-list" class="pl-4 pr-2 space-y-1 border-t border-slate-800/60 pt-2 pb-1">
              {category.subcategories.map((sub) => (
                <a 
                  href={getRelativeLocaleUrl(lang, sub.rawUrl)} 
                  class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800 transition-colors"
                >
                  <span class="text-base">{sub.icon}</span>
                  <span>{sub.name}</span>
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a 
            href={categoryUrl} 
            class="flex items-center gap-2.5 px-4 py-3 rounded-2xl text-base font-semibold text-slate-200 hover:text-amber-400 hover:bg-slate-800 transition-colors"
          >
            <span>{category.icon}</span>
            <span>{category.name}</span>
          </a>
        );
      })}
    </nav>
  </div>
</header>

<script>
  // Script interactivo para controlar la navegación móvil y el acordeón de subcategorías
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  const subcatBtn = document.getElementById('toggle-subcat-btn');
  const subcatList = document.getElementById('subcat-list');
  const subcatArrow = document.getElementById('subcat-arrow');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isHidden = menu.classList.toggle('hidden');
      if (iconOpen && iconClose) {
        iconOpen.classList.toggle('hidden', !isHidden);
        iconClose.classList.toggle('hidden', isHidden);
      }
    });
  }

  if (subcatBtn && subcatList) {
    subcatBtn.addEventListener('click', () => {
      subcatList.classList.toggle('hidden');
      if (subcatArrow) {
        subcatArrow.classList.toggle('rotate-180');
      }
    });
  }
</script>