---
import { getLangFromUrl, useTranslations, getRelativeLocaleUrl } from '../i18n/ui';

const currentYear = new Date().getFullYear();
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="bg-slate-950 text-slate-400 py-12 border-t border-slate-800/80 mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col md:flex-row justify-between items-center md:items-start gap-8">
    
    <div class="text-center md:text-left max-w-2xl">
      <div class="flex items-center justify-center md:justify-start gap-2 mb-3">
        <img class="h-8 w-auto object-contain" src="/images/logozenzone-removebg-preview.png" alt="ZenZone Logo" />
        <span class="text-lg font-black text-white">ZenZone</span>
      </div>
      <p class="text-xs leading-relaxed mb-3 text-slate-400">
        {t('footer.avisoAfiliados')}
      </p>
      <p class="text-xs text-slate-500">
        {t('footer.preciosDisclaimer')}
      </p>
    </div>

    <div class="flex flex-col sm:flex-row gap-6 text-sm text-center md:text-right">
      <div class="flex flex-col gap-2">
        <span class="font-extrabold text-slate-200 uppercase tracking-wider text-xs mb-1">{t('footer.navegacion')}</span>
        <a href={getRelativeLocaleUrl(lang, '/')} class="hover:text-amber-400 transition-colors">{t('nav.inicio')}</a>
        <a href={getRelativeLocaleUrl(lang, '/perifericos')} class="hover:text-amber-400 transition-colors">{t('nav.perifericos')}</a>
        <a href={getRelativeLocaleUrl(lang, '/sillas-oficina')} class="hover:text-amber-400 transition-colors">{t('nav.sillasOficina')}</a>
        <a href={getRelativeLocaleUrl(lang, '/mesas-escritorio')} class="hover:text-amber-400 transition-colors">{t('nav.mesas')}</a>
      </div>

      <div class="flex flex-col gap-2">
        <span class="font-extrabold text-slate-200 uppercase tracking-wider text-xs mb-1">{t('footer.legal')}</span>
        <a href={getRelativeLocaleUrl(lang, '/aviso-legal')} class="hover:text-amber-400 transition-colors">{t('footer.avisoLegal')}</a>
        <a href={getRelativeLocaleUrl(lang, '/cookies')} class="hover:text-amber-400 transition-colors">{t('footer.cookies')}</a>
      </div>
    </div>

  </div>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 mt-10 pt-8 border-t border-slate-900 text-center text-xs text-slate-500">
    &copy; {currentYear} ZenZone. {t('footer.derechos')}
  </div>
</footer>