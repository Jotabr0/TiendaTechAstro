---
// src/components/TablaComparativa.astro
import { getLangFromUrl, useTranslations } from '../i18n/ui';

interface Product {
  name: string;
  imageUrl: string;
  feature1: string;
  feature2: string;
  amazonUrl: string;
  badge?: string;
}

interface Props {
  products: Product[];
}

const { products } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="not-prose my-10 w-full">
  {/* Indicador de deslizamiento para dispositivos móviles */}
  <div class="flex items-center justify-between text-xs font-semibold text-slate-400 mb-2 px-1 md:hidden">
    <span>{lang === 'en' ? `Swipe table to compare (${products.length} models)` : `Desliza la tabla para comparar (${products.length} modelos)`}</span>
    <div class="flex items-center gap-1 text-amber-500">
      <span>→</span>
    </div>
  </div>

  <div class="w-full overflow-x-auto pb-4 shadow-sm rounded-3xl border border-slate-200 bg-white">
    <table class="w-full text-center border-collapse table-fixed" style={`min-width: ${Math.max(600, products.length * 180)}px`}>
      
      {/* Fila 1: Imágenes, Nombres y Etiquetas */}
      <thead>
        <tr>
          {products.map((p) => (
            <th class="p-4 sm:p-6 border-b border-slate-200 bg-slate-50/80 relative align-bottom">
              {p.badge && (
                <span class="absolute top-0 left-1/2 -translate-x-1/2 bg-gradient-to-r from-amber-500 to-amber-600 text-white text-[10px] font-extrabold uppercase px-3 py-1 rounded-b-xl whitespace-nowrap shadow-sm z-10">
                  {p.badge}
                </span>
              )}
              <div class="h-28 flex items-center justify-center mb-3 pt-2">
                <img src={p.imageUrl} alt={p.name} class="max-h-full max-w-full object-contain transition-transform duration-300 hover:scale-105" loading="lazy" />
              </div>
              <h3 class="font-extrabold text-slate-900 text-sm leading-tight">{p.name}</h3>
            </th>
          ))}
        </tr>
      </thead>

      {/* Fila 2 y 3: Características clave */}
      <tbody>
        <tr>
          {products.map((p) => (
            <td class="p-4 border-b border-slate-100 text-xs sm:text-sm text-slate-600 bg-white">
              <span class="block text-[10px] font-bold text-slate-400 uppercase mb-1">{lang === 'en' ? 'Key Feature' : 'Característica Clave'}</span>
              <span class="font-semibold text-slate-800">{p.feature1}</span>
            </td>
          ))}
        </tr>
        <tr>
          {products.map((p) => (
            <td class="p-4 border-b border-slate-100 text-xs sm:text-sm text-slate-600 bg-white">
              <span class="block text-[10px] font-bold text-slate-400 uppercase mb-1">{lang === 'en' ? 'Best For' : 'Ideal para'}</span>
              <span class="font-semibold text-slate-800">{p.feature2}</span>
            </td>
          ))}
        </tr>

        {/* Fila 4: Botones de Llamada a la Acción (CTA) */}
        <tr>
          {products.map((p) => (
            <td class="p-4 bg-slate-50/80">
              <a 
                href={p.amazonUrl} 
                target="_blank" 
                rel="nofollow noopener sponsored" 
                class="block w-full bg-slate-900 hover:bg-amber-500 hover:text-slate-950 text-white font-black py-3 px-3 rounded-xl text-xs sm:text-sm transition-all shadow-sm"
              >
                {t('tabla.verEnAmazon')}
              </a>
            </td>
          ))}
        </tr>
      </tbody>
    </table>
  </div>
</div>