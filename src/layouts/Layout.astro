---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        
        {/* Favicon del sitio con el logo de ZenZone */}
        <link rel="icon" type="image/png" href="/images/logozenzone-removebg-preview.png" />
        <link rel="apple-touch-icon" href="/images/logozenzone-removebg-preview.png" />

        <title>{title} | ZenZone</title>

        {/* Umami Analytics - Rastreo en tiempo real */}
        <script defer src="https://cloud.umami.is/script.js" data-website-id="e4057548-890f-4408-b62f-3f453ec88a0f"></script>
    </head>
    <body class="bg-slate-50 text-slate-900 font-sans antialiased min-h-screen flex flex-col selection:bg-amber-400 selection:text-slate-950">
        <Header />
        <main class="flex-grow w-full max-w-6xl mx-auto px-4 sm:px-6 py-8 md:py-12">
            <slot />
        </main>
        <Footer />

        {/* Script interactivo para registrar clics en enlaces de Amazon en tiempo real en Umami */}
        <script>
            document.addEventListener('click', (event) => {
                const link = (event.target as HTMLElement)?.closest('a[href*="amazon."]') as HTMLAnchorElement | null;
                if (link && (window as any).umami) {
                    const amazonUrl = link.href;
                    const pageUrl = window.location.pathname;
                    (window as any).umami.track('clic_afiliado_amazon', {
                        url: amazonUrl,
                        pagina: pageUrl
                    });
                }
            });
        </script>
    </body>
</html>
